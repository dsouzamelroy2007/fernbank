# Copy to infra/.env and adjust for local use. Never commit the real .env.

# Postgres
DB_NAME=fernbank
DB_USER=fernbank
DB_PASSWORD=fernbank
DB_PORT=5432

# Backend
SERVER_PORT=8080
JWT_ISSUER=http://localhost:8080
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# base64-encoded 32 random bytes, e.g. `openssl rand -base64 32`
MFA_SECRET_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# HTTP Basic credential for /actuator/prometheus (every other /actuator/** path needs
# an ADMIN JWT; Prometheus has no OAuth2 client-credentials flow, so this one path
# accepts Basic instead). Only read if you also bring up the observability profile
# (`docker compose --profile observability up`) — plaintext local-dev defaults, same
# convention as DB_PASSWORD above. Change infra/prometheus/prometheus.yml's
# basic_auth block to match if you override these.
ACTUATOR_PROMETHEUS_USER=prometheus
ACTUATOR_PROMETHEUS_PASSWORD=prometheus

# Shared secret between backend and bff (same value in both places, e.g.
# `openssl rand -base64 32`). Lets the backend trust the bff's forwarded client IP on
# login requests for LoginRateLimiter, instead of always seeing the bff's own container
# IP - without this, every login through the bff collapses onto one rate-limit bucket
# per email. Blank by default; only matters once a deployment sits behind a real proxy
# chain (Vercel/Render), not for local Docker Compose.
INTERNAL_SERVICE_KEY=

# BFF (NestJS) — sits between the frontend and the backend as of Phase 8. The browser
# never sees a JWT: this process owns an encrypted httpOnly session cookie, exchanges it
# for the Java access token server-side, and is the sole caller of the backend for
# everything except Swagger UI convenience access.
# base64-encoded 32 random bytes, e.g. `openssl rand -base64 32` — same pattern as
# MFA_SECRET_ENCRYPTION_KEY above. If unset, an ephemeral key is generated at startup
# (dev/test convenience) — sessions encrypted this run won't decrypt after a restart.
BFF_SESSION_ENCRYPTION_KEY=
BFF_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Unset in dev — localhost is always same-site regardless of port. Only needed in a real
# deployment where the frontend and BFF sit on different subdomains of the same parent
# domain (see docs/adr for the cookie-domain decision).
BFF_SESSION_COOKIE_DOMAIN=
BFF_PORT=4000

# Frontend
# Browser-facing BFF base URL, baked into the client bundle at build time. The browser
# talks to the BFF exclusively now — it never reaches the backend directly.
NEXT_PUBLIC_BFF_BASE_URL=http://localhost:4000
WEB_PORT=3000
