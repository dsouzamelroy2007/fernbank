# Copy to frontend/.env.local for `npm run dev` outside Docker. Never commit the real file.

# Browser-facing backend origin, inlined into the client bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Server-only backend origin for Route Handlers (app/api/auth/**). Under Docker Compose
# this must be the backend container's service name (http://backend:8080), never
# "localhost" — from inside the frontend container, localhost means itself. Falls back to
# http://localhost:8080 in code when unset, which is correct for bare `npm run dev`.
API_INTERNAL_BASE_URL=http://localhost:8080
